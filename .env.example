# 서울 열린데이터광장 일반 인증키 — https://data.seoul.go.kr → 로그인 → 인증키 신청
SEOUL_API_KEY=
# 지하철 실시간 도착 전용 인증키 — 열린데이터광장에서 별도 신청 (미설정 시 SEOUL_API_KEY 사용)
SEOUL_SUBWAY_API_KEY=
# (선택) AgentCore Runtime 전용 — 세션 간 공유 L2 캐시·쿼터 원장용 DynamoDB 테이블명 (미설정 시 L1 전용, 세션별 캐시/쿼터)
# CACHE_TABLE_NAME=
# (선택) AgentCore Runtime 전용 — 키별 일일 API 호출 예산, 소진 시 stale-only 응답으로 전환 (기본 1000)
# QUOTA_DAILY_LIMIT=1000
