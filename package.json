{
  "name": "seoul-opendata-mcp",
  "version": "0.7.0",
  "description": "MCP server for Seoul Open Data Plaza real-time city APIs (서울 열린데이터광장 실시간 도시데이터 MCP 서버)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whchoi98/seoul-opendata-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/whchoi98/seoul-opendata-mcp/issues"
  },
  "homepage": "https://github.com/whchoi98/seoul-opendata-mcp#readme",
  "bin": {
    "seoul-opendata-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seoul",
    "open-data",
    "korea"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "bundle": "npm run build && npx @anthropic-ai/mcpb pack . seoul-opendata-mcp.mcpb && npx @anthropic-ai/mcpb clean seoul-opendata-mcp.mcpb",
    "prepublishOnly": "npm run build",
    "workshop:deploy": "tsx scripts/workshop-deploy.ts",
    "workshop:code": "tsx scripts/workshop-code.ts",
    "workshop:collect": "tsx scripts/workshop-collect.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.693.0",
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/lib-dynamodb": "^3.693.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "fast-xml-parser": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "js-yaml": "^4.3.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
